# Phase 2 LLM (Groq)
PHASE2_LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Groq Rate Limits
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000

# Phase 3 LLM (Gemini)
PHASE3_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google & MCP Server (Phase 5)
MCP_SERVER_URL=https://mcp-server-1-production-7ea1.up.railway.app/sse
GOOGLE_DOC_ID=your-google-doc-id
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# App Config
TARGET_APP_ID=com.nextbillion.groww
REVIEW_WINDOW_WEEKS=8
PULSE_RECIPIENT_EMAIL=your-email@example.com

